# Copia este archivo a .env para desarrollo local. Los valores de ejemplo pasan la validación de
# src/config/env.validation.ts pero NO sirven en producción (allí la configuración vive en el
# parámetro SSM /oscarymateo/prod/backend-env).

# Base de datos. Con docker-compose.yml el Postgres local escucha solo en 127.0.0.1 y su clave sale
# de POSTGRES_PASSWORD (si no la defines, de DB_PASSWORD). No apuntes DB_HOST/DB_PORT a producción
# (el túnel de db-pull-prod.sh usa el 15432): los tests de integración y db-setup.sh escriben datos.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ferreyepes
DB_PASSWORD=ferreyepes
DB_NAME=ferreyepes
# POSTGRES_PASSWORD=ferreyepes
# "true" (en cualquier combinación de mayúsculas) activa SSL con el certificado de RDS; local: false.
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Obligatoria solo en producción (NODE_ENV=production): dominio compartido por el front y la API
# para las cookies de sesión. En local se deja vacía o sin definir.
# COOKIE_DOMAIN=tiendadeoscarymateo.com

# Mínimo 32 caracteres y distinto de "change-me". Genera uno propio con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=valor-de-ejemplo-solo-para-desarrollo-local-no-usar-en-produccion

# S3. Las llaves son solo de desarrollo: en el servidor no existen y se usa el rol del EC2.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# QZ Tray (impresión de recibos): llave privada y certificado PEM, cada uno en base64 y en una sola
# línea (Git Bash: base64 -w0 private-key.pem; PowerShell:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("private-key.pem"))).
# Los de ejemplo son el base64 de "change-me": la app arranca, pero no puede firmar hasta que
# pongas los reales. `npm run check:env:prod` exige que sean PEM válidos.
# En producción viven en un segundo parámetro SSM (/oscarymateo/prod/backend-env-extra/QZ_CERTIFICATE_B64,
# con dos líneas NOMBRE=valor), porque no caben en los 4096 caracteres del principal; deploy.sh las
# agrega a backend.env.
QZ_PRIVATE_KEY_B64=Y2hhbmdlLW1l
QZ_CERTIFICATE_B64=Y2hhbmdlLW1l
